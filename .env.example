BACNET_LAB_HTTP_HOST=0.0.0.0
BACNET_LAB_HTTP_PORT=8080
BACNET_LAB_DB_PATH=bacnet_lab.db
BACNET_LAB_LOG_LEVEL=INFO
BACNET_LAB_BACNET_IP=0.0.0.0
BACNET_LAB_BACNET_PORT_START=47808

# BACnet → MQTT gateway (OFF by default — without this, telemetry will not publish)
# Uncomment to enable when running the app against a local Mosquitto broker:
# BACNET_LAB_MQTT_ENABLED=1
# BACNET_LAB_MQTT_HOST=localhost
# BACNET_LAB_MQTT_PORT=1883
# BACNET_LAB_MQTT_PREFIX=bacnet
# Topics: bacnet/{device_id}/telemetry/...  bacnet/{device_id}/command
#         bacnet/{device_id}/write_status/...

# Auth — leave empty to disable (NOT recommended in production)
BACNET_LAB_AUTH_USERNAME=admin
BACNET_LAB_AUTH_PASSWORD=change-me-please
